{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "esnext"
    ],
    "module": "ESNext",
    "moduleResolution": "node",
    "rootDir": ".",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "target": "ESNext",
    "types": [
      "node"
    ],
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules/@dynatrace"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "./**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
